{
  "schemaVersion": 1,
  "id": "sophisticatedlibrary",
  "version": "${version}",
  "name": "SophisticatedLibrary",
  "description": "A library mod for the sophisticated mods",
  "license": "GNU General Public License v3.0",
  "authors": ["Salandora"],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/sophisticated-library-fabric",
    "issues": "https://github.com/Salandora/SophisticatedLibrary/issues",
    "sources": "https://github.com/Salandora/SophisticatedLibrary"
  },
  "icon": "assets/sophisticatedlibrary/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "com.github.salandora.sophisticatedlibrary.model.SophisticatedModelClient"
    ],
    "main": [
      "com.github.salandora.sophisticatedlibrary.SophisticatedLibrary",
      "com.github.salandora.sophisticatedlibrary.common.SophisticatedCommon",
      "com.github.salandora.sophisticatedlibrary.model.SophisticatedModel",
      "com.github.salandora.sophisticatedlibrary.loot.SophisticatedLoot"
    ]
  },
  "mixins": [
    "sophisticatedlibrary.mixins.json",
    "sophisticatedlibrary.event.mixins.json",
    "sophisticatedlibrary.loot.mixins.json",
    "sophisticatedlibrary.model.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_version}"
  },
  "custom": {
