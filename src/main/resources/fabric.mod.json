      "net/minecraft/class_2248": ["com/github/salandora/sophisticatedlibrary/common/extensions/block/SophisticatedBlock"],
      "net/minecraft/class_2680": ["com/github/salandora/sophisticatedlibrary/common/extensions/block/SophisticatedBlockState"],
      "net/minecraft/class_9322": ["com/github/salandora/sophisticatedlibrary/common/extensions/component/SophisticatedDataComponentHolder"],
      "net/minecraft/class_9288": ["com/github/salandora/sophisticatedlibrary/common/extensions/component/SophisticatedItemContainerContents"]
    }
  }
